flowchart TD
    subgraph TUI["tui/ 终端界面层"]
        APP["YenaiApp<br/>输入 / 展示 / 命令"]
        CHAT["ChatLog<br/>消息流"]
        CONFIG["ConfigScreen<br/>配置弹窗"]
        I18N["i18n.py<br/>中文文案"]
    end

    subgraph CORE["core/ 核心层（不依赖界面技术）"]
        FACTORY["factory.create_session<br/>唯一装配点"]
        SESSION["AgentSession<br/>流式 + 工具循环 + 存档提交"]
        CONTEXT["context.build_messages<br/>上下文裁剪"]
        EVENTS["events<br/>TurnStarted / TextDelta / ToolCall* / Turn*"]
        REGISTRY["ToolRegistry<br/>ToolSpec + 执行与错误归一"]
        FILES["FileToolbox<br/>10 个文件工具（沙箱根注入）"]
        SEARCH["SearchClient<br/>searchWeb 联网搜索"]
        FETCH["WebFetcher<br/>fetchWeb 网页抓取（curl + trafilatura）"]
        CLI["CommandRunner<br/>RunCli 本地命令行（shell=False）"]
        BACKEND["LlmBackend / OpenAIBackend"]
        TRANSCRIPT["Transcript<br/>chat_history/*.txt"]
        CONFIGSTORE["ConfigStore<br/>config.ini"]
    end

    APP -->|"创建会话"| FACTORY
    APP -->|"消费事件"| SESSION
    APP --> CHAT
    APP --> CONFIG
    APP --> I18N
    CONFIG --> CONFIGSTORE
    FACTORY --> SESSION
    FACTORY --> BACKEND
    FACTORY --> REGISTRY
    FACTORY --> TRANSCRIPT
    SESSION --> CONTEXT
    SESSION --> EVENTS
    SESSION --> REGISTRY
    SESSION --> BACKEND
    SESSION --> TRANSCRIPT
    REGISTRY --> FILES
    REGISTRY --> SEARCH
    REGISTRY --> FETCH
    REGISTRY --> CLI
    CONFIGSTORE -->|"[search] 段"| SEARCH
    FETCH -->|"subprocess: curl"| CURL["本地 curl<br/>下载 HTML"]
    FETCH -->|"HTML → Markdown"| TRAFILATURA["trafilatura<br/>正文提取"]
    CLI -->|"subprocess.run(shell=False)"| PROGRAMS["本机已安装的程序<br/>（当前用户权限）"]

    classDef ui fill:#e8f0fe,stroke:#4a6fa5;
    classDef core fill:#f3f7ec,stroke:#5b7f3a;
    classDef ext fill:#fdf3e7,stroke:#a5754a;
    class APP,CHAT,CONFIG,I18N ui;
    class FACTORY,SESSION,CONTEXT,EVENTS,REGISTRY,FILES,SEARCH,FETCH,CLI,BACKEND,TRANSCRIPT,CONFIGSTORE core;
    class CURL,TRAFILATURA,PROGRAMS ext;