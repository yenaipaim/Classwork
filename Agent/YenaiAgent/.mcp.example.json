{
  "mcpServers": {
    "PeiHospitalMCP": {
      "type": "streamable_http",
      "url": "http://127.0.0.1:9000/mcp",
      "connect_timeout": 5,
      "timeout": 30
    },
    "stdio-example": {
      "type": "stdio",
      "command": "python",
      "args": [
        "D:\\mcp\\your_server.py"
      ]
    },
    "http-example": {
      "type": "streamable_http",
      "url": "https://mcp.example.com/mcp",
      "headers": {
        "Authorization": "Bearer ${MCP_TOKEN}"
      }
    }
  }
}
